# Supabase (Postgres + Auth). Both values are PUBLIC and safe in the browser —
# row-level security on the database is the protection, not these strings.
# Get them from your Supabase project: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# One-time schema/seed application (never stored in the app, never committed):
#   SUPABASE_DB_PASSWORD="..." node scripts/apply-schema.mjs
# This connects to db.<project-ref>.supabase.co:5432 with the postgres user.
